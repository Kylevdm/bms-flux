# Home Assistant access for bms-flux investigation tickets.
# Copy to .env (gitignored) and fill in. Never commit .env.

# Base URL of the HA box, no trailing slash.
HA_URL=http://homeassistant.local:8123

# Long-lived access token: HA profile (bottom-left) -> Security ->
# Long-lived access tokens -> Create token. Gives REST (/api/...) and
# WebSocket (/api/websocket) access as your user.
HA_TOKEN=
